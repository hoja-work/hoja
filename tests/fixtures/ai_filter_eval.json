{
  "about": "Plain-language filters for a triage lead, each with the view filter it must produce (Hoja's view grammar, docs/views.md). Placeholders: $user:<name>, $label:<name>, $state:<name>, $project:<name> are replaced by ids from the fixture workspace (tests/test_ai_filter.py). expected null means the request is too vague to turn into filters: the right answer is to abstain (no filter), never a confident wrong one. Written before the parser (artifacts/runs/20261123-views-depth/PROTOTYPES.md).",
  "workspace": {
    "users": ["Lead", "Alice", "Bob"],
    "me": "Lead",
    "states": ["Backlog", "Todo", "In Progress", "In Review", "Done", "Canceled"],
    "labels": ["Bug", "Feature", "Improvement", {"group": "area", "children": ["api", "ui"]}],
    "projects": ["Platform", "Mobile App"]
  },
  "cases": [
    {"q": "unassigned bugs", "expected": {"assignee": {"is": null}, "labels": {"includesAny": ["$label:Bug"]}}},
    {"q": "unassigned bugs created in the last week that are due within a week", "expected": {"assignee": {"is": null}, "labels": {"includesAny": ["$label:Bug"]}, "createdAt": {"after": "-P1W"}, "dueDate": {"before": "P1W"}}},
    {"q": "my tasks", "expected": {"assignee": {"isMe": true}}},
    {"q": "assigned to me", "expected": {"assignee": {"isMe": true}}},
    {"q": "everything assigned to Alice", "expected": {"assignee": {"is": "$user:Alice"}}},
    {"q": "tasks assigned to alice or bob", "expected": {"assignee": {"isEitherOf": ["$user:Alice", "$user:Bob"]}}},
    {"q": "not assigned to me", "expected": {"assignee": {"isMe": false}}},
    {"q": "issues I created", "expected": {"creator": {"isMe": true}}},
    {"q": "created by Bob", "expected": {"creator": {"is": "$user:Bob"}}},
    {"q": "urgent issues", "expected": {"priority": {"is": 1}}},
    {"q": "high priority bugs", "expected": {"priority": {"is": 2}, "labels": {"includesAny": ["$label:Bug"]}}},
    {"q": "urgent or high priority", "expected": {"priority": {"isEitherOf": [1, 2]}}},
    {"q": "tasks with no priority", "expected": {"priority": {"is": 0}}},
    {"q": "low priority features", "expected": {"priority": {"is": 4}, "labels": {"includesAny": ["$label:Feature"]}}},
    {"q": "todo", "expected": {"state": {"is": "$state:Todo"}}},
    {"q": "in progress tasks assigned to me", "expected": {"state": {"is": "$state:In Progress"}, "assignee": {"isMe": true}}},
    {"q": "everything in review", "expected": {"state": {"is": "$state:In Review"}}},
    {"q": "backlog items without an assignee", "expected": {"state": {"is": "$state:Backlog"}, "assignee": {"is": null}}},
    {"q": "open bugs", "expected": {"stateType": {"isNeitherOf": ["completed", "canceled"]}, "labels": {"includesAny": ["$label:Bug"]}}},
    {"q": "completed in the last week", "expected": {"completedAt": {"after": "-P1W"}}},
    {"q": "done tasks", "expected": {"stateType": {"is": "completed"}}},
    {"q": "canceled issues", "expected": {"stateType": {"is": "canceled"}}},
    {"q": "closed bugs", "expected": {"stateType": {"isEitherOf": ["completed", "canceled"]}, "labels": {"includesAny": ["$label:Bug"]}}},
    {"q": "overdue", "expected": {"dueDate": {"is": "overdue"}}},
    {"q": "overdue tasks assigned to me", "expected": {"dueDate": {"is": "overdue"}, "assignee": {"isMe": true}}},
    {"q": "due today", "expected": {"dueDate": {"is": "today"}}},
    {"q": "due tomorrow", "expected": {"dueDate": {"is": "tomorrow"}}},
    {"q": "due this week", "expected": {"dueDate": {"before": "P1W"}}},
    {"q": "due in the next 3 days", "expected": {"dueDate": {"before": "P3D"}}},
    {"q": "tasks with no due date", "expected": {"dueDate": {"is": null}}},
    {"q": "created today", "expected": {"createdAt": {"is": "today"}}},
    {"q": "created yesterday", "expected": {"createdAt": {"is": "yesterday"}}},
    {"q": "created in the last 2 weeks", "expected": {"createdAt": {"after": "-P2W"}}},
    {"q": "updated in the last 3 days", "expected": {"updatedAt": {"after": "-P3D"}}},
    {"q": "not updated in a month", "expected": {"updatedAt": {"before": "-P1M"}}},
    {"q": "bugs not touched in 2 weeks", "expected": {"labels": {"includesAny": ["$label:Bug"]}, "updatedAt": {"before": "-P2W"}}},
    {"q": "api issues", "expected": {"labels": {"includesAny": ["$label:api"]}}},
    {"q": "anything in the area group", "expected": {"labels": {"includesAny": ["$label:area"]}}},
    {"q": "bugs that are not ui", "expected": {"labels": {"includesAny": ["$label:Bug"], "includesNone": ["$label:ui"]}}},
    {"q": "tasks without labels", "expected": {"labels": {"is": null}}},
    {"q": "bugs and improvements", "expected": {"labels": {"includesAny": ["$label:Bug", "$label:Improvement"]}}},
    {"q": "Platform project bugs", "expected": {"project": {"is": "$project:Platform"}, "labels": {"includesAny": ["$label:Bug"]}}},
    {"q": "tasks in Mobile App", "expected": {"project": {"is": "$project:Mobile App"}}},
    {"q": "tasks with no project", "expected": {"project": {"is": null}}},
    {"q": "sub-issues only", "expected": {"isSubIssue": {"is": true}}},
    {"q": "top-level tasks with sub-issues", "expected": {"isSubIssue": {"is": false}, "hasSubIssues": {"is": true}}},
    {"q": "tasks I'm subscribed to", "expected": {"subscriber": {"isMe": true}}},
    {"q": "title contains \"login\"", "expected": {"title": {"containsIgnoreCase": "login"}}},
    {"q": "what should I work on next", "expected": null},
    {"q": "the stuff blocking the launch", "expected": null},
    {"q": "anything risky", "expected": null},
    {"q": "tasks the customer complained about", "expected": null},
    {"q": "important things", "expected": null},
    {"q": "everything Alice and I discussed yesterday", "expected": null}
  ]
}
