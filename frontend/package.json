{
  "name": "hoja-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:styles": "stylelint 'src/**/*.css'",
    "test:layout": "node ../scripts/test-project-layout.cjs && node ../scripts/test-settings-layout.cjs && node ../scripts/test-task-layout.cjs && node ../scripts/test-work-surface-layout.cjs && node ../scripts/test-agent-chat-layout.cjs && node ../scripts/test-overflow-layout.cjs && node ../scripts/test-list-scroll-layout.cjs && node ../scripts/test-agent-reply-layout.cjs && node ../scripts/test-brand-and-welcome-composer.cjs && node ../scripts/test-overlay-dismiss.cjs && node ../scripts/test-state-shape.cjs",
    "preview": "vite preview",
    "check:production": "python3 ../scripts/verify-web-production.py",
    "test:shell-alignment": "node ../scripts/test-shell-top-alignment.cjs",
    "test:pages": "node ../scripts/test-page-invariants.cjs",
    "test:mobile": "node ../scripts/mobile-audit.cjs --scale --gate",
    "test:mobile:matrix": "node ../scripts/ui-probes/mobile-viewport-matrix.cjs",
    "lint:ui": "eslint src",
    "test:modal": "node ../scripts/test-task-modal-polish.cjs",
    "test:my-tasks": "node ../scripts/test-my-tasks-completed.cjs",
    "test:task-parity": "node ../scripts/test-task-surface-parity.cjs",
    "test:board-prefill": "node ../scripts/ui-probes/board-create-prefill.cjs",
    "test:board-swipe": "node ../scripts/ui-probes/board-swipe-scroll.cjs",
    "test:board-hidden-columns": "node ../scripts/ui-probes/board-hidden-columns.cjs",
    "test:task-toolbar": "node ../scripts/ui-probes/task-toolbar-placement.cjs",
    "test:project-overview": "node ../scripts/test-project-overview.cjs",
    "test:project-activity": "node ../scripts/test-project-activity.cjs",
    "test:markdown": "node ../scripts/test-markdown-conformance.cjs && node ../scripts/test-markdown-surfaces.cjs",
    "test:markdown:spec": "node ../scripts/test-markdown-conformance.cjs",
    "test:views": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/test-view-filters.mjs",
    "test:cycles": "node ../scripts/test-cycle-metrics.mjs && node ../scripts/test-cycle-selection.mjs",
    "test:status-age": "node ../scripts/test-status-age.mjs",
    "test:setup": "node ../scripts/test-setup-wizard.cjs",
    "test:setup:browser": "node ../scripts/test-setup-wizard-browser.cjs",
    "lint:vocab": "node scripts/check-task-vocabulary.mjs",
    "test:reviews": "node scripts/check-reviews.mjs && node --experimental-strip-types scripts/test-reviews-gate.mjs && node scripts/test-reviews-guard-mutations.mjs",
    "test:design": "node scripts/check-design-tokens.mjs && node scripts/check-design-tokens.mjs --self-test",
    "measure:reviews": "node scripts/ui-probes/reviews-parity.mjs",
    "test:pulse": "node scripts/check-pulse.mjs",
    "test:phone-signin": "node --experimental-strip-types scripts/test-phone-signin.mjs",
    "test:settings": "node scripts/check-settings.mjs",
    "test:agent-screens": "node ../scripts/test-agent-screens-geometry.cjs",
    "test:runner-contract": "../.venv/bin/python ../scripts/check-runner-contract.py",
    "lint:tailwind": "node scripts/canonicalize-tailwind.mjs",
    "fix:tailwind-intellisense": "node scripts/fix-tailwind-intellisense.mjs",
    "test:tailwind-intellisense": "node scripts/test-fix-tailwind-intellisense.mjs",
    "test:spacing-parity": "node scripts/test-spacing-parity.cjs",
    "test:tailwind": "node scripts/test-canonicalize-tailwind.mjs",
    "lint:state-shape": "node scripts/check-state-shape-source.mjs --self-test && node scripts/check-state-shape-source.mjs",
    "test:state-shape": "node ../scripts/test-state-shape.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@openuidev/react-headless": "0.18.5",
    "@openuidev/react-lang": "1.1.0",
    "@openuidev/react-ui": "0.18.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "blobatar": "2.7.0",
    "cn": "^0.5.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "1.70.0",
    "morphicons": "2.0.2",
    "motion": "^14.14.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/language-server": "^0.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react-grab": "0.2.0",
    "stylelint": "18.0.0",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "zod": "^4.6.7",
    "@ag-ui/core": "^1.0.3"
  }
}
