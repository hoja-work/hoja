{
  "name": "hoja-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:styles": "stylelint 'src/**/*.css'",
    "test:layout": "node ../scripts/test-project-layout.cjs && node ../scripts/test-settings-layout.cjs && node ../scripts/test-issue-layout.cjs && node ../scripts/test-work-surface-layout.cjs && node ../scripts/test-agent-chat-layout.cjs && node ../scripts/test-overflow-layout.cjs && node ../scripts/test-list-scroll-layout.cjs && node ../scripts/test-agent-reply-layout.cjs && node ../scripts/test-brand-and-welcome-composer.cjs",
    "preview": "vite preview",
    "check:production": "python3 ../scripts/verify-web-production.py",
    "test:pages": "node ../scripts/test-page-invariants.cjs",
    "test:mobile": "node ../scripts/mobile-audit.cjs --scale --gate",
    "lint:ui": "eslint src",
    "test:modal": "node ../scripts/test-issue-modal-polish.cjs",
    "test:my-issues": "node ../scripts/test-my-issues-completed.cjs",
"test:issue-parity": "node ../scripts/test-issue-surface-parity.cjs",
"test:board-prefill": "node ../scripts/test-board-create-prefill.cjs",
"test:project-overview": "node ../scripts/test-project-overview.cjs",
"test:project-activity": "node ../scripts/test-project-activity.cjs",
"test:markdown": "node ../scripts/test-markdown-conformance.cjs && node ../scripts/test-markdown-surfaces.cjs",
"test:markdown:spec": "node ../scripts/test-markdown-conformance.cjs",
"test:cycles": "node ../scripts/test-cycle-metrics.mjs && node ../scripts/test-cycle-selection.mjs",
"test:status-age": "node ../scripts/test-status-age.mjs",
    "test:setup": "node ../scripts/test-setup-wizard.cjs",
    "test:setup:browser": "node ../scripts/test-setup-wizard-browser.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@openuidev/react-headless": "0.18.5",
    "@openuidev/react-lang": "1.1.0",
    "@openuidev/react-ui": "0.18.5",
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react-grab": "0.2.0",
    "stylelint": "18.0.0",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "zod": "^4.6.7",
    "@ag-ui/core": "^1.0.3"
  }
}
